# =========================================
# GENERAL
# =========================================

# OS-specific files
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
# Keep .env.example in git, but ignore all other .env files
.env*
!.env.example

# Database files
*.db

# =========================================
# IDEs & EDITORS
# =========================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# IntelliJ
.idea/
*.iws
*.iml
*.ipr
/out/

# =========================================
# BACKEND (Java / Spring Boot / Maven)
# =========================================

# Maven build output
target/

# Maven wrapper
# We want to keep the wrapper properties file
.mvn/
!/.mvn/wrapper/maven-wrapper.properties

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear

# Virtual machine crash logs
hs_err_pid*

# =========================================
# FRONTEND (Node / Vite / React)
# =========================================

# Dependency directory
node_modules/

# Build output
dist/
build/

# Vite cache
.vite/

# Test coverage
coverage/
.nyc_output/

# Other
*.tsbuildinfo
.eslintcache
